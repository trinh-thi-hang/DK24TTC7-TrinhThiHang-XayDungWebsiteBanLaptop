@model IEnumerable<MEGATECH.Models.EF.Product>

<style>
    /* Reset & Container */
    .product-grid-container {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -10px;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .product-item {
        padding: 15px 10px;
    }

    /* Thẻ sản phẩm chính */
    .nhan-product-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        position: relative;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .nhan-product-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }

    /* Phần hình ảnh */
    .card-img-box {
        position: relative;
        height: 240px;
        background: linear-gradient(145deg, #f6f8fd, #f1f3f8);
        border-radius: 20px 20px 0 0;
        padding: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .card-img-box img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.6s ease;
        filter: drop-shadow(0 10px 10px rgba(0,0,0,0.05));
    }

    .nhan-product-card:hover .card-img-box img {
        transform: scale(1.15) rotate(-3deg);
    }

    /* Trái tim yêu thích */
    .card-favorite {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 32px;
        height: 32px;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(4px);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a0a5aa;
        font-size: 14px;
        cursor: pointer;
        z-index: 10;
        transition: all 0.3s;
        opacity: 0;
        transform: translateX(10px);
    }

    .nhan-product-card:hover .card-favorite {
        opacity: 1;
        transform: translateX(0);
    }

    .card-favorite:hover {
        background: #ff4757;
        color: #fff;
        box-shadow: 0 4px 10px rgba(255, 71, 87, 0.3);
    }

    /* Nhãn dán New / Sale */
    .card-badges {
        position: absolute;
        top: 15px;
        left: 15px;
        display: flex;
        flex-direction: column;
        gap: 5px;
        z-index: 10;
    }

    .badge-pill {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #fff;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .badge-new {
        background: #2ed573;
    }

    .badge-sale {
        background: #ff4757;
    }

    /* Phần thông tin */
    .card-details {
        padding: 20px;
        position: relative;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-radius: 0 0 20px 20px;
    }

    .card-title {
        margin: 0 0 10px 0;
    }

    .card-title a {
        font-size: 16px;
        font-weight: 700;
        color: #2f3542;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.2s;
    }

    .card-title a:hover {
        color: #1e90ff;
    }

    .card-price-wrap {
        margin-top: auto;
    }

    .price-current {
        font-size: 18px;
        font-weight: 800;
        color: #2f3542;
    }

    .price-old {
        font-size: 13px;
        color: #a4b0be;
        text-decoration: line-through;
        margin-left: 8px;
        font-weight: 500;
    }

    .card-stock {
        font-size: 12px;
        color: #747d8c;
        margin-top: 5px;
        font-weight: 500;
    }

    /* Nút giỏ hàng nổi (FAB) */
    .fab-cart {
        position: absolute;
        top: -22px; /* Đẩy lên nằm giữa ranh giới ảnh và chữ */
        right: 20px;
        width: 44px;
        height: 44px;
        background: #2f3542;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        box-shadow: 0 6px 12px rgba(47, 53, 66, 0.2);
        transition: all 0.3s ease;
        z-index: 10;
    }

    .fab-cart:hover {
        background: #1e90ff;
        color: #fff;
        transform: scale(1.1);
        box-shadow: 0 8px 15px rgba(30, 144, 255, 0.3);
    }

    /* Overlay Hết hàng */
    .sold-out-box {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 15;
        border-radius: 20px 20px 0 0;
    }

    .sold-out-text {
        background: #2f3542;
        color: #fff;
        padding: 8px 20px;
        border-radius: 30px;
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .fab-disabled {
        background: #ced6e0 !important;
        cursor: not-allowed;
        box-shadow: none !important;
    }
    
    .fab-disabled:hover {
        transform: none !important;
    }
</style>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="col-lg-3 col-md-4 col-6 product-item @item.ProductCategory.Alias">
            <div class="nhan-product-card">
                
                <div class="card-img-box">
                    <img src="@item.Image" alt="@item.Title">
                    
                    @if (item.SoLuong <= 0)
                    {
                        <div class="sold-out-box">
                            <span class="sold-out-text">Hết hàng</span>
                        </div>
                    }

                    <div class="card-badges">
                        @if (item.IsNew == true)
                        {
                            <span class="badge-pill badge-new">New</span>
                        }
                        @if (item.GiamGia > 0)
                        {
                            <span class="badge-pill badge-sale">-@item.GiamGia%</span>
                        }
                    </div>
                </div>

                <div data-id="@item.MaSanPham" class="card-favorite">
                    <i class="fa fa-heart-o"></i>
                </div>

                <div class="card-details">
                    @if (item.SoLuong > 0)
                    {
                        <a href="#" class="fab-cart btnAddToCart" data-id="@item.MaSanPham" title="Thêm vào giỏ">
                            <i class="fa fa-shopping-cart"></i>
                        </a>
                    }
                    else
                    {
                        <a href="javascript:void(0)" class="fab-cart fab-disabled" title="Hết hàng">
                            <i class="fa fa-phone"></i>
                        </a>
                    }

                    <h6 class="card-title">
                        <a href="/chi-tiet/@item.Alias-p@(item.MaSanPham)">@item.Title</a>
                    </h6>
                    
                    <div class="card-price-wrap">
                        <span class="price-current">@MEGATECH.Common.Common.FormatNumber(item.GiaBan, 0)₫</span>
                        @if (item.GiamGia > 0)
                        {
                            <span class="price-old">@MEGATECH.Common.Common.FormatNumber(item.GiaNiemYet, 0)₫</span>
                        }
                    </div>
                    
                    <div class="card-stock">Kho: @item.SoLuong</div>
                </div>

            </div>
        </div>
    }
}