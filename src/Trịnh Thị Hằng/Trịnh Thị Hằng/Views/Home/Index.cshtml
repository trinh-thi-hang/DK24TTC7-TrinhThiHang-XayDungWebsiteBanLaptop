@{
    ViewBag.Title = "MEGATECH - Hệ thống Laptop hàng đầu của Trịnh Thị Hằng";
    ViewBag.SeoDescription = "Chuyên cung cấp các dòng Laptop Gaming, Văn phòng và MacBook chính hãng chất lượng cao.";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    
    <link href="~/Content/assets/styles/bootstrap4/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/OwlCarousel2-2.2.1/owl.carousel.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/OwlCarousel2-2.2.1/owl.theme.default.css" rel="stylesheet" />
    <link href="~/Content/assets/plugins/OwlCarousel2-2.2.1/animate.css" rel="stylesheet" />
    
    <link rel="stylesheet" type="text/css" href="~/Content/assets/styles/main_styles.css">
    <link href="~/Content/assets/styles/responsive.css" rel="stylesheet" />

    <style>
        :root {
            --primary-color: #2563eb; /* Xanh công nghệ */
            --secondary-color: #1e293b; /* Xanh đen sang trọng */
            --bg-light: #f8fafc; /* Nền xám nhạt hiện đại */
            --text-dark: #0f172a;
            --card-bg: #ffffff;
        }

        body { 
            font-family: 'Nunito', sans-serif; 
            background-color: var(--bg-light); 
            color: var(--text-dark); 
            overflow-x: hidden; 
        }

        /* ---------------------------------
           1. SLIDER KIỂU CÔNG NGHỆ
        -----------------------------------*/
        .slider-wrapper {
            padding: 20px;
            background-color: var(--bg-light);
        }

        #homeCarousel {
            border-radius: 40px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(37, 99, 235, 0.15);
            position: relative;
        }

        .carousel-item {
            height: 550px;
            background-color: var(--secondary-color);
        }

        .carousel-item::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(to right, rgba(30, 41, 59, 0.9) 0%, rgba(30, 41, 59, 0.2) 100%);
            z-index: 1;
        }

        .carousel-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        .carousel-caption-custom {
            position: absolute;
            top: 50%;
            left: 8%;
            transform: translateY(-50%);
            z-index: 10;
            color: #fff;
            text-align: left;
            max-width: 500px;
        }

        .carousel-caption-custom h1 {
            font-size: 3.5rem;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 20px;
            color: #fff;
            letter-spacing: -1px;
        }

        .carousel-caption-custom p {
            font-size: 1.2rem;
            margin-bottom: 35px;
            font-weight: 600;
            color: #cbd5e1;
        }

        .shop_now_button {
            display: inline-block;
            background: var(--primary-color);
            padding: 16px 45px;
            border-radius: 50px;
            color: #fff !important;
            font-weight: 800;
            font-size: 1.1rem;
            text-transform: uppercase;
            text-decoration: none !important;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            border: 3px solid var(--primary-color);
        }

        .shop_now_button:hover {
            background: transparent;
            color: var(--primary-color) !important;
            transform: scale(1.05);
        }

        .section_container { 
            padding: 70px 0; 
        }

        /* ---------------------------------
           2. LỢI ÍCH DỊCH VỤ - LAPTOP
        -----------------------------------*/
        .benefit_card {
            background: var(--card-bg);
            padding: 15px 25px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            box-shadow: 0 8px 25px rgba(0,0,0,0.04);
            transition: all 0.3s ease;
            margin-bottom: 20px;
            border: 2px solid transparent;
        }

        .benefit_card:hover {
            border-color: var(--primary-color);
            transform: translateY(-5px);
        }

        .benefit_icon {
            width: 55px;
            height: 55px;
            min-width: 55px;
            background: #dbeafe;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
        }

        .benefit_icon i {
            font-size: 24px;
            color: var(--primary-color);
        }

        .benefit_card:hover .benefit_icon {
            background: var(--primary-color);
        }
        .benefit_card:hover .benefit_icon i {
            color: #fff;
        }

        .benefit_content h6 {
            font-weight: 800;
            margin-bottom: 3px;
            font-size: 15px;
            color: var(--secondary-color);
        }

        /* ---------------------------------
           3. FOOTER
        -----------------------------------*/
        .footer {
            background: var(--secondary-color);
            color: #f1f5f9;
            padding: 80px 0 0;
            border-top-left-radius: 60px;
            border-top-right-radius: 60px;
            margin-top: 40px;
        }

        .footer_title {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 25px;
            color: #fff;
        }

        .footer_list li a { color: #94a3b8; text-decoration: none; transition: 0.3s; }
        .footer_list li a:hover { color: var(--primary-color); padding-left: 8px; }

        .footer_social li a { 
            display: flex; align-items: center; justify-content: center;
            width: 45px; height: 45px; background: rgba(255,255,255,0.05);
            border-radius: 15px; color: #fff; transition: 0.3s; 
        }
        .footer_social li a:hover { background: var(--primary-color); transform: translateY(-3px); }

        .footer_bottom {
            margin-top: 60px;
            padding: 25px 0;
            background: #0f172a;
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            color: #64748b;
        }
    </style>
</head>
<body>

    <div class="super_container">
        
        <div class="slider-wrapper container-fluid">
            <div id="homeCarousel" class="carousel slide carousel-fade" data-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="https://images.unsplash.com/photo-1603302576837-37561b2e2302?q=80&w=1468&auto=format&fit=crop" alt="Laptop Gaming">
                        <div class="carousel-caption-custom">
                            <h1 class="animated fadeInLeft">Laptop Đỉnh<br>Phá Bỏ Giới Hạn</h1>
                            <p class="animated fadeInRight">Sở hữu những dòng Laptop mạnh mẽ nhất từ Trịnh Thị Hằng cho công việc và giải trí.</p>
                            <a href="/san-pham" class="shop_now_button animated fadeInUp">Mua ngay</a>
                        </div>
                    </div>
                    
                    <div class="carousel-item">
                        <img src="https://images.unsplash.com/photo-1517336712468-077648f3e841?q=80&w=1467&auto=format&fit=crop" alt="MacBook">
                        <div class="carousel-caption-custom">
                            <h1 class="animated fadeInLeft">Sang Trọng<br>& Đẳng Cấp</h1>
                            <p class="animated fadeInRight">Dòng MacBook chính hãng, thiết kế tinh tế cho trải nghiệm hoàn hảo.</p>
                            <a href="/san-pham" class="shop_now_button animated fadeInUp">Khám phá</a>
                        </div>
                    </div>
                </div>
                
                <a class="carousel-control-prev" href="#homeCarousel" data-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </a>
                <a class="carousel-control-next" href="#homeCarousel" data-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </a>
            </div>
        </div>

        <div class="benefit">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 col-md-6">
                        <div class="benefit_card">
                            <div class="benefit_icon"><i class="fa fa-truck"></i></div>
                            <div class="benefit_content">
                                <h6>Giao Hỏa Tốc</h6>
                                <p>Nhận máy chỉ trong 2 giờ</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="benefit_card">
                            <div class="benefit_icon"><i class="fa fa-shield"></i></div>
                            <div class="benefit_content">
                                <h6>Bảo Hành 2 Năm</h6>
                                <p>Cam kết chính hãng 100%</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="benefit_card">
                            <div class="benefit_icon"><i class="fa fa-wrench"></i></div>
                            <div class="benefit_content">
                                <h6>Hỗ Trợ Kỹ Thuật</h6>
                                <p>Cài đặt phần mềm miễn phí</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="benefit_card">
                            <div class="benefit_icon"><i class="fa fa-credit-card"></i></div>
                            <div class="benefit_content">
                                <h6>Trả Góp 0%</h6>
                                <p>Thủ tục nhanh, xét duyệt dễ</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="section_container">
            <div class="container">
                @Html.Action("MenuProductCategory", "Menu")
            </div>
        </div>

        <div class="section_container" style="background-color: #fff; border-radius: 40px; margin: 0 20px;">
            <div class="container">
                @Html.Action("MenuArrivals", "Menu")
            </div>
        </div>

        <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="col-lg-4 mb-5 mb-lg-0">
                        <h4 class="footer_title">MEGATECH LAPTOP</h4>
                        <p style="color: #94a3b8; font-size: 15px; line-height: 1.8; font-weight: 600;">
                            Hệ thống bán lẻ máy tính của Trịnh Thị Hằng. Chúng tôi cam kết mang lại những sản phẩm công nghệ tiên tiến nhất với dịch vụ hậu mãi số 1.
                        </p>
                     
                    </div>
                    
                    <div class="col-lg-4 mb-5 mb-lg-0 px-lg-5">
                        <h4 class="footer_title">Danh Mục Sản Phẩm</h4>
                        <ul class="footer_list">
                            <li><i class="fa fa-angle-right"></i><a href="/san-pham">Laptop Gaming</a></li>
                            <li><i class="fa fa-angle-right"></i><a href="/san-pham">Laptop Văn Phòng</a></li>
                            <li><i class="fa fa-angle-right"></i><a href="/san-pham">MacBook Pro / Air</a></li>
                            <li><i class="fa fa-angle-right"></i><a href="/tin-tuc">Linh kiện & Phụ kiện</a></li>
                        </ul>
                    </div>
                    
                    <div class="col-lg-4">
                        <h4 class="footer_title">Liên Hệ</h4>
                        <ul class="footer_list">
                            <li><i class="fa fa-map-marker"></i> <span style="color:#cbd5e1;">Số 1 Trịnh Thị Hằng, TP. Trà Vinh</span></li>
                            <li><i class="fa fa-phone"></i> <span style="color:#cbd5e1;">0987 654 321</span></li>
                            <li><i class="fa fa-envelope"></i> <span style="color:#cbd5e1;">hangtrinh@megatech.vn</span></li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="footer_bottom">
                <div class="container">
                    &copy; 2026 Bản quyền thuộc về Trịnh Thị Hằng - Laptop.
                </div>
            </div>
        </footer>
    </div>

    <script src="~/Content/assets/js/jquery-3.2.1.min.js"></script>
    <script src="~/Content/assets/styles/bootstrap4/popper.js"></script>
    <script src="~/Content/assets/styles/bootstrap4/bootstrap.min.js"></script>
</body>
</html>